# patterns without a leading slash match at any depth — they already cover
# packages/*/dist, packages/*/node_modules, packages/*/coverage, etc.
node_modules/
dist/
coverage/
*.log
*.tsbuildinfo
.DS_Store
.env
.env.*
docs/.svelte-kit
.wrangler/

# Heisenbench step counts (`pnpm bench:count`)
packages/neosanitize/bench/heisenbench.json

# generated root entry stubs (shipped via package.json `files`, not committed)
packages/neosanitize/legacy.*

# ogygia build-time keep-client route (auto-removed; only survives a crashed build)
**/.ogygia-keep-client/
